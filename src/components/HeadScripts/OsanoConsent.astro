---
/**
 * Osano consent management platform (cookie/privacy banner), plus the plumbing that lets
 * other non-essential third-party scripts react to the visitor's choice:
 *
 *  - Loads the real Osano loader script when PUBLIC_OSANO_USER_ID / PUBLIC_OSANO_CONFIG_ID
 *    are configured (Osano admin console → set up a domain for this site → Install →
 *    the generated <script src="https://cmp.osano.com/{userId}/{configId}/osano.js">).
 *    No-ops otherwise: no banner, and every script below that waits on
 *    `window.__onOsanoConsent` simply never runs — fails safe toward less tracking.
 *  - Exposes `window.__onOsanoConsent(callback)`: calls `callback({analytics, marketing,
 *    personalization})` once Osano resolves, and again every time the visitor changes
 *    their choice. PostHogAnalytics.astro and TwitterPixel.astro subscribe to this
 *    instead of each re-implementing Osano's async init/polling.
 *  - Mirrors consent into Google Consent Mode v2 (`gtag('consent', 'update', ...)`) so
 *    GTM-managed tags respect the same choice. The *default* (deny-all) consent state is
 *    set in astro.config.ts, before GTM's own script tag, so GTM never fires a tag before
 *    a default exists — this script only updates that state once Osano has an answer.
 */
const userId = import.meta.env.PUBLIC_OSANO_USER_ID;
const configId = import.meta.env.PUBLIC_OSANO_CONFIG_ID;
---

<script is:inline define:vars={{ userId, configId }}>
  (function () {
    if (userId && configId && !document.getElementById("osano-script")) {
      var loader = document.createElement("script");
      loader.id = "osano-script";
      loader.async = true;
      loader.src = "https://cmp.osano.com/" + userId + "/" + configId + "/osano.js";
      document.head.appendChild(loader);
    }

    var listeners = [];
    var lastState = null;
    var boundCm = null;

    function notify() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm) return;
      lastState = {
        analytics: Boolean(cm.analytics),
        marketing: Boolean(cm.marketing),
        personalization: Boolean(cm.personalization),
      };
      listeners.forEach(function (fn) {
        fn(lastState);
      });
    }

    // Osano.cm isn't available immediately after the loader script is appended above —
    // it initializes asynchronously. Worse: `window.Osano.cm` gets replaced with a new
    // object partway through init (confirmed empirically — a stub, then the real
    // instance), so binding listeners once and stopping would silently orphan them the
    // moment that swap happens. Keep checking for a new reference indefinitely instead;
    // the check itself is a cheap object-identity comparison, re-binding only runs on
    // an actual swap.
    function ensureBound() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm || cm === boundCm) return;
      if (boundCm) {
        boundCm.removeEventListener("osano-cm-initialized", notify);
        boundCm.removeEventListener("osano-cm-consent-saved", notify);
      }
      cm.addEventListener("osano-cm-initialized", notify);
      cm.addEventListener("osano-cm-consent-saved", notify);
      boundCm = cm;
      notify();
    }

    ensureBound();
    setInterval(ensureBound, 250);

    window.__onOsanoConsent = function (callback) {
      if (lastState) callback(lastState);
      listeners.push(callback);
    };

    window.__onOsanoConsent(function (state) {
      if (typeof window.gtag !== "function") return;
      window.gtag("consent", "update", {
        analytics_storage: state.analytics ? "granted" : "denied",
        ad_storage: state.marketing ? "granted" : "denied",
        ad_user_data: state.marketing ? "granted" : "denied",
        ad_personalization: state.marketing ? "granted" : "denied",
        functionality_storage: state.personalization ? "granted" : "denied",
        personalization_storage: state.personalization ? "granted" : "denied",
        security_storage: "granted",
      });
    });
  })();
</script>
